 "script": {
  "voice": "vi-VN-NamMinhNeural",
  "brand": true,
  "intro": "Green Skyline của TBS Land, ngay mặt tiền Quốc lộ một K, cửa ngõ Đông Bắc thành phố.",
  "pois": [
   "Bệnh viện Hoàn Mỹ Thủ Đức liền kề, chăm sóc sức khỏe chỉ một phút.",
   "Đại siêu thị đối diện dự án, khoảng ba phút, mua sắm mỗi ngày.",
   "Khu Đại học Quốc gia khoảng chín phút, môi trường học tập hàng đầu.",
   "Ga metro Thủ Đức khoảng bảy phút, vào trung tâm thật nhanh.",
   "Khu công nghiệp Sóng Thần khoảng bảy phút, thuận tiện đi làm.",
   "Sân bay Tân Sơn Nhất cách gần mười tám ki lô mét."
  ],
  "outro": "Green Skyline, một nghìn hai trăm chín mươi sáu căn hộ. Nhận bảng giá ngay."
 }
