 "script": {
  "voice": "vi-VN-NamMinhNeural",
  "brand": true,
  "intro": "Một phút tới bệnh viện, siêu thị! Green Skyline, mặt tiền Quốc lộ một K.",
  "pois": [
   "Bệnh viện Hoàn Mỹ Thủ Đức liền kề, chỉ một phút xe máy.",
   "Đại siêu thị ngay đối diện, băng qua đường chỉ một phút.",
   "Khu Đại học Quốc gia khoảng mười phút, môi trường học tập hàng đầu.",
   "Ga metro Thủ Đức khoảng mười sáu phút, vào trung tâm thật nhanh.",
   "Khu Công nghệ cao khoảng mười bảy phút, thuận tiện cho kỹ sư, chuyên gia.",
   "Sân bay Tân Sơn Nhất cách khoảng hai mươi ki lô mét."
  ],
  "outro": "Green Skyline mời quý khách tham quan nhà thật và nhận tư vấn chuyên sâu!",
  "style": "song-dong"
 }
